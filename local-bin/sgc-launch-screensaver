#!/bin/bash

# Launches the SGC (Stargate Command) logo video as a fullscreen screensaver
# on every output. Sway port of the old Hyprland version — swaymsg's
# "focus output" (unlike Hyprland's dispatch focusmonitor) doesn't warp the
# real cursor, so the old IPC-socket sync dance and cursor-position watchdog
# to dodge false idle-resume triggers aren't needed here: swayidle's `resume`
# handler (wired in sway config) does the killing instead.

VIDEO="$HOME/.local/share/sgc-screensaver/sgc.mp4"
INPUT_CONF="$HOME/.local/share/sgc-screensaver/mpv-input.conf"
APP_ID="org.sgc.screensaver"

pgrep -f "wayland-app-id=$APP_ID" &>/dev/null && exit 0
[[ -f "$VIDEO" ]] || exit 1

walker -q &>/dev/null

focused=$(swaymsg -t get_outputs -r | jq -r '.[] | select(.focused) | .name')

for name in $(swaymsg -t get_outputs -r | jq -r '.[].name'); do
  swaymsg focus output "$name" >/dev/null
  swaymsg exec -- mpv \
    --loop=inf \
    --fullscreen \
    --no-osc \
    --no-osd-bar \
    --input-conf="$INPUT_CONF" \
    --cursor-autohide=always \
    --keep-open=yes \
    --really-quiet \
    --stop-screensaver=no \
    --speed=0.5 \
    --wayland-app-id="$APP_ID" \
    --title="SGC Screensaver" \
    "$VIDEO" >/dev/null
done

swaymsg focus output "$focused" >/dev/null
