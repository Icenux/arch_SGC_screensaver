#!/bin/bash

# Launches the SGC (Stargate Command) logo video as a fullscreen screensaver
# on every monitor, replacing Omarchy's stock text-effect screensaver.
#
# Reuses the class "org.omarchy.screensaver" on purpose: Omarchy's own
# windowrule (apps/system.conf) already makes that class fullscreen/float/
# slide-in. Appending any suffix to the class (e.g. ".sgc") breaks the
# fullscreen request for reasons not worth re-deriving, so don't rename it.
#
# Windows are spawned via `hyprctl dispatch exec` (not a plain background
# `mpv &`) because that's what actually maps each instance onto its target
# monitor - backgrounding mpv directly from this script mapped every
# instance onto the same (first) monitor instead.
#
# Each instance is targeted at its monitor via `[workspace ID silent]`
# (ID = that monitor's own currently-active workspace), NOT via
# `dispatch focusmonitor`. focusmonitor warps the real cursor to switch
# monitor focus, which hypridle's ext-idle-notify sees as genuine input
# activity - that immediately fired hypridle's on-resume (sgc-kill-
# screensaver) within ~1s of launch, silently killing the screensaver right
# after it appeared. The `silent` workspace target avoids any focus/cursor
# change entirely, so launching no longer self-triggers a kill.
#
# Dismissal: mpv quits itself on any key/click/scroll (mpv-input.conf) for
# whichever instance has focus, and the watchdog below catches plain mouse
# movement via an exact cursor-position diff (mpv has no "any motion"
# event to bind).
#
# hypridle's on-resume is deliberately NOT used for this (see hypridle.conf):
# the newly-mapped fullscreen window ends up under the already-stationary
# cursor, which fires a pointer "enter" on it - Hyprland's ext-idle-notify
# counts that as activity even with cursor:no_warps set (no_warps only
# blocks explicit warps, not enter/leave from a window appearing under a
# still cursor). With on-resume wired up, hypridle saw a false "Resumed"
# and killed the screensaver within ~1s of it appearing, every time,
# regardless of cursor:no_warps. The watchdog below doesn't have this
# problem: it compares exact `hyprctl cursorpos` coordinates, which an
# enter/leave event does not change (only genuine movement does).
#
# Each instance starts paused (--pause) with its own IPC socket. Once all
# sockets exist (windows mapped), an unpause command is fired at all of them
# back-to-back so playback actually starts in the same instant on every
# monitor - relying on independent decode-start timing instead would let
# multi-monitor instances drift out of phase.

VIDEO="$HOME/.local/share/sgc-screensaver/sgc.mp4"
INPUT_CONF="$HOME/.local/share/sgc-screensaver/mpv-input.conf"
APP_ID="org.omarchy.screensaver"
IPC_DIR="/tmp/sgc-screensaver-$$"

# Exit early if the screensaver (this one, or the stock one) is already running
pgrep -f "$APP_ID" &>/dev/null && exit 0

[[ -f "$VIDEO" ]] || exit 1

# Silently quit Walker on overlay
walker -q &>/dev/null

mkdir -p "$IPC_DIR"
sockets=()
monitor_count=0

for ws in $(hyprctl monitors -j | jq -r '.[] | .activeWorkspace.id'); do
  sock="$IPC_DIR/$monitor_count.sock"
  sockets+=("$sock")
  hyprctl dispatch exec "[workspace $ws silent] mpv \
    --loop=inf \
    --fullscreen \
    --no-osc \
    --no-osd-bar \
    --input-conf=$INPUT_CONF \
    --input-ipc-server=$sock \
    --pause \
    --cursor-autohide=always \
    --keep-open=yes \
    --really-quiet \
    --stop-screensaver=no \
    --speed=0.5 \
    --wayland-app-id=$APP_ID \
    --title=\"SGC Screensaver\" \
    $VIDEO"
  monitor_count=$((monitor_count + 1))
done

# Wait for every instance's IPC socket to appear (mpv creates it once ready)
deadline=$((SECONDS + 5))
for sock in "${sockets[@]}"; do
  while [[ ! -S "$sock" && $SECONDS -lt $deadline ]]; do
    sleep 0.02
  done
done

# Unpause all instances back-to-back so they start playing in sync
for sock in "${sockets[@]}"; do
  echo '{"command":["set_property","pause",false]}' | socat - "UNIX-CONNECT:$sock" &>/dev/null &
done
wait

rm -rf "$IPC_DIR"

# Wait for all instances to finish mapping before we start counting them
sleep 0.5

start_pos=$(hyprctl cursorpos)
while true; do
  running=$(pgrep -cf "$APP_ID")
  pos=$(hyprctl cursorpos)
  if [[ "$running" -lt "$monitor_count" || "$pos" != "$start_pos" ]]; then
    break
  fi
  sleep 0.3
done

pkill -f "$APP_ID" &>/dev/null
